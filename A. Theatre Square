#include <iostream>

using namespace std;

int main() {
    // Using long long to prevent 32-bit overflow
    long long n, m, a;
    cin >> n >> m >> a;
    
    // Efficient integer arithmetic for ceiling division
    long long stones_n = (n + a - 1) / a;
    long long stones_m = (m + a - 1) / a;
    
    cout << stones_n * stones_m << endl;
    return 0;
}

